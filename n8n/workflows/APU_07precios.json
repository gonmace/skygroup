      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"precios\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"number\"\n          },\n          \"precio\": {\n            \"type\": \"number\"\n          },\n          \"moneda\": {\n            \"type\": \"string\"\n          },\n          \"confianza\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"alta\",\n              \"media\",\n              \"baja\"\n            ]\n          },\n          \"fuente\": {\n            \"type\": \"string\"\n          },\n          \"nota\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"precio\",\n          \"moneda\",\n          \"confianza\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"precios\"\n  ]\n}"
      },
      "id": "5d1ea9ae-3468-490b-82c0-5698089a903b",
      "name": "Esquema · Precios",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        560,
        540
      ],
      "notes": "Esquema de lo que devuelve la IA. Si lo cambias, revisa también apu_generador/ia.py."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Moneda: {{ $('Webhook').item.json.body.moneda }}\nCiudad o región de los precios: {{ $('Webhook').item.json.body.region }}\nFecha de hoy: {{ $('Webhook').item.json.body.fecha }}\nInsumos a estimar (id, descripcion, unidad, tipo; si trae precio_actual y moneda_actual, es una REVISIÓN: di en la nota si ese precio es razonable y propón el tuyo): {{ JSON.stringify($('Webhook').item.json.body.insumos) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "={{ $json.system_prompt }}"
        }
      },
      "id": "c4d4e2d5-bdc1-4dbe-8ab3-b931b457ffcf",
