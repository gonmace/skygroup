    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"filas\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"descripcion\": {\n            \"type\": \"string\"\n          },\n          \"unidad\": {\n            \"type\": \"string\"\n          },\n          \"cantidad\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"desperdicio_pct\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"personas\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"codigo_catalogo\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"codigo_subitem\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"nuevo\": {\n            \"type\": [\n              \"boolean\",\n              \"null\"\n            ]\n          },\n          \"justificacion\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          }\n        },\n        \"required\": [\n          \"descripcion\",\n          \"unidad\"\n        ]\n      }\n    },\n    \"consultas\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"tipo\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"opciones\",\n              \"dato\"\n            ]\n          },\n          \"pregunta\": {\n            \"type\": \"string\"\n          },\n          \"motivo\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"recomendada\": {\n            \"type\": \"string\"\n          },\n          \"opciones\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"clave\": {\n                  \"type\": \"string\"\n                },\n                \"etiqueta\": {\n                  \"type\": \"string\"\n                },\n                \"codigo_subitem\": {\n                  \"type\": [\n                    \"string\",\n                    \"null\"\n                  ]\n                },\n                \"filas\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"descripcion\": {\n                        \"type\": \"string\"\n                      },\n                      \"unidad\": {\n                        \"type\": \"string\"\n                      },\n                      \"cantidad\": {\n                        \"type\": [\n                          \"number\",\n                          \"null\"\n                        ]\n                      },\n                      \"desperdicio_pct\": {\n                        \"type\": [\n                          \"number\",\n                          \"null\"\n                        ]\n                      },\n                      \"personas\": {\n                        \"type\": [\n                          \"number\",\n                          \"null\"\n                        ]\n                      },\n                      \"codigo_catalogo\": {\n                        \"type\": [\n                          \"string\",\n                          \"null\"\n                        ]\n                      },\n                      \"codigo_subitem\": {\n                        \"type\": [\n                          \"string\",\n                          \"null\"\n                        ]\n                      },\n                      \"nuevo\": {\n                        \"type\": [\n                          \"boolean\",\n                          \"null\"\n                        ]\n                      },\n                      \"justificacion\": {\n                        \"type\": [\n                          \"string\",\n                          \"null\"\n                        ]\n                      }\n                    },\n                    \"required\": [\n                      \"descripcion\",\n                      \"unidad\"\n                    ]\n                  }\n                }\n              },\n              \"required\": [\n                \"clave\",\n                \"etiqueta\"\n              ]\n            }\n          },\n          \"por_que\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"tipo\",\n          \"pregunta\",\n          \"recomendada\",\n          \"por_que\"\n        ]\n      }\n    },\n    \"rendimiento\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"horas_jornada\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"filas\",\n    \"consultas\"\n  ]\n}"
