    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tarifas\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"modelo\": {\n            \"type\": \"string\"\n          },\n          \"entrada_usd_mtok\": {\n            \"type\": \"number\"\n          },\n          \"salida_usd_mtok\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"modelo\",\n          \"entrada_usd_mtok\",\n          \"salida_usd_mtok\"\n        ]\n      }\n    },\n    \"fuente\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"tarifas\",\n    \"fuente\"\n  ]\n}"
      },
      "id": "a13a51be-cbd7-4d21-a8a1-b6d14bcf1aca",
