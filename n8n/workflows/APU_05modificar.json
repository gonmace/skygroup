      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"materiales\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"filas\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"descripcion\": {\n                \"type\": \"string\"\n              },\n              \"unidad\": {\n                \"type\": \"string\"\n              },\n              \"cantidad\": {\n                \"type\": \"number\"\n              },\n              \"desperdicio_pct\": {\n                \"type\": \"number\"\n              },\n              \"personas\": {\n                \"type\": \"number\"\n              },\n              \"codigo_catalogo\": {\n                \"type\": \"string\"\n              },\n              \"codigo_subitem\": {\n                \"type\": \"string\"\n              },\n              \"nuevo\": {\n                \"type\": \"boolean\"\n              },\n              \"justificacion\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"descripcion\",\n              \"unidad\"\n            ]\n          }\n        }\n      },\n      \"required\": [\n        \"filas\"\n      ]\n    },\n    \"mano_obra\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"filas\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"descripcion\": {\n                \"type\": \"string\"\n              },\n              \"unidad\": {\n                \"type\": \"string\"\n              },\n              \"cantidad\": {\n                \"type\": \"number\"\n              },\n              \"desperdicio_pct\": {\n                \"type\": \"number\"\n              },\n              \"personas\": {\n                \"type\": \"number\"\n              },\n              \"codigo_catalogo\": {\n                \"type\": \"string\"\n              },\n              \"codigo_subitem\": {\n                \"type\": \"string\"\n              },\n              \"nuevo\": {\n                \"type\": \"boolean\"\n              },\n              \"justificacion\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"descripcion\",\n              \"unidad\"\n            ]\n          }\n        },\n        \"rendimiento\": {\n          \"type\": \"number\"\n        },\n        \"horas_jornada\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"filas\"\n      ]\n    },\n    \"equipos\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"filas\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"descripcion\": {\n                \"type\": \"string\"\n              },\n              \"unidad\": {\n                \"type\": \"string\"\n              },\n              \"cantidad\": {\n                \"type\": \"number\"\n              },\n              \"desperdicio_pct\": {\n                \"type\": \"number\"\n              },\n              \"personas\": {\n                \"type\": \"number\"\n              },\n              \"codigo_catalogo\": {\n                \"type\": \"string\"\n              },\n              \"codigo_subitem\": {\n                \"type\": \"string\"\n              },\n              \"nuevo\": {\n                \"type\": \"boolean\"\n              },\n              \"justificacion\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"descripcion\",\n              \"unidad\"\n            ]\n          }\n        }\n      },\n      \"required\": [\n        \"filas\"\n      ]\n    },\n    \"actividad\": {\n      \"type\": \"string\"\n    },\n    \"resumen_cambios\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"materiales\",\n    \"mano_obra\",\n    \"equipos\",\n    \"actividad\",\n    \"resumen_cambios\"\n  ]\n}"
      },
