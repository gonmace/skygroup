      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "notes": "Aquí vive el prompt de sistema. Edita el texto para mejorar el comportamiento de la IA."
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.1"
        },
        "builtInTools": {
          "webSearch": {
            "searchContextSize": "medium",
            "allowedDomains": "openai.com"
          }
