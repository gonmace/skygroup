# ── Proyecto ──────────────────────────────────────────────────────────────────
# Nombre del proyecto (usado en contenedores Docker y nginx)
PROJECT_NAME=miproyecto

# ── Dominios ──────────────────────────────────────────────────────────────────
# Dominio principal de Django
DOMAIN=tudominio.com

# ── Puertos (consecutivos desde APP_PORT) ─────────────────────────────────────
# Django se expone en APP_PORT. n8n y MCP usan los siguientes.
APP_PORT=8000
# Puerto externo para n8n (solo si N8N_DOMAIN está definido)
N8N_PORT=8001
# Puerto externo para n8n-MCP (solo si N8N_MCP_ENABLED=true)
N8N_MCP_PORT=8002

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
DEBUG=False
ALLOWED_HOSTS=tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com
ADMIN_URL=mi-panel-secreto/
# URL pública sin barra final (enlaces absolutos en correos)
# SITE_URL=https://tudominio.com
# ADMIN_EMAIL=admin@tudominio.com   # recibe emails de errores 500 (requiere SMTP)
# GUNICORN_WORKERS=3                # recomendado: 2 x CPUs + 1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# POSTGRES_MODE: "container" (por defecto) o "host"
#   - container: PostgreSQL corre en Docker (incluido en docker-compose)
#   - host: PostgreSQL ya instalado en el servidor; contenedores se conectan
#           vía host.docker.internal. Requiere configurar pg_hba.conf manualmente.
POSTGRES_MODE=container
POSTGRES_DB=miproyecto_db
POSTGRES_USER=miproyecto_user
POSTGRES_PASSWORD=cambia-esta-contraseña
# "postgres" para container, "host.docker.internal" para host
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Puerto expuesto en el host (solo dev: DBeaver, etc.)
POSTGRES_HOST_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Producción: usar nombre del servicio Docker ("redis")
REDIS_URL=redis://redis:6379/0
# Desarrollo nativo (Django en host, Redis en Docker Desktop):
# REDIS_URL=redis://localhost:6379/0

# Límite de memoria de Redis (política allkeys-lru)
REDIS_MAXMEMORY=256mb

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Si EMAIL_HOST no está definido, se usa el backend de consola (cuando EMAIL_HOST está vacío).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-app
DEFAULT_FROM_EMAIL=noreply@tudominio.com

# ── n8n (opcional) ────────────────────────────────────────────────────────────
# n8n se habilita definiendo N8N_DOMAIN. Se despliega en su propio subdominio.
# N8N_ENCRYPTION_KEY debe mantenerse constante — cambiarla invalida credenciales.
# N8N_ENCRYPTION_KEY=clave-larga-y-secreta
# N8N_DOMAIN=n8n.tudominio.com
# Fijar versiones evita upgrades accidentales (por defecto: latest). Actualizar: make n8n-update
# N8N_VERSION=latest
# N8N_MCP_VERSION=latest

# ── n8n-MCP (opcional, requiere n8n) ─────────────────────────────────────────
# Servidor MCP sobre HTTP para integrar n8n con Claude Code u otros clientes MCP.
# N8N_MCP_ENABLED=true
# Generado en n8n: Settings > API
# N8N_API_KEY=tu-api-key-de-n8n
# Token para autenticar clientes MCP
# N8N_MCP_AUTH_TOKEN=token-secreto

# ── Media ─────────────────────────────────────────────────────────────────────
# Modo local/S3, bucket y CDN: Admin → Almacenamiento de media / CDN (sin reiniciar).
# Mover lo que ya está en disco: python manage.py media_a_cdn --dry-run | --borrar-local
# Segundos de validez de las URLs firmadas (archivos privados)
# S3_URL_EXPIRE=300
# Alerta en el panel cuando el disco del VPS supera este %
DISK_ALERT_PERCENT=85

# Token de los endpoints internos /api/*/interno/ (n8n, cron). Vacío = deshabilitados.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# INTERNAL_API_TOKEN=

# Límites de subida (bytes). nginx.conf permite 30M por petición.
# FOTO_MAX_SIZE=26214400        # 25 MB por foto (Registros)
# ATTACHMENT_MAX_SIZE=20971520  # 20 MB por adjunto (Tareas)

# Ruta del SQLite (solo sin Postgres)
# SQLITE_PATH=db.sqlite3

# Copias de seguridad a conservar (scripts/backup.sh)
# BACKUP_KEEP=10

# Registros: clave de Google Maps Static API para la imagen del widget de mapa (mapa_1p / mapa_2_puntos).
# Sin clave el widget sigue mostrando los puntos, pero no genera la imagen del informe.
GOOGLE_MAPS_API_KEY=
